// Prisma schema: https://www.prisma.io/docs/orm/v7/prisma-schema/overview
// The connection URL is configured in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Model names and fields are camelCase in TypeScript; @map/@@map give the
// PostgreSQL tables and columns conventional snake_case names.

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
  UNKNOWN

  @@map("message_status")
}

model User {
  id                 String         @id @default(uuid(7)) @db.Uuid
  phoneNumber        String         @unique @map("phone_number")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  nextWhatsappSendAt DateTime?      @map("next_whatsapp_send_at") @db.Timestamptz(3)
  conversations      Conversation[]

  @@map("users")
}

// A WhatsApp conversation as reported by Meta, not a session the application invents.
// Inbound messages carry no conversation data, so the WhatsApp fields stay null until a
// webhook that does carry them (a status update for a message we send) enriches the row.
// category and originType are text rather than enums: Meta adds values over time.
model Conversation {
  id                     String    @id @default(uuid(7)) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  user                   User      @relation(fields: [userId], references: [id])
  messages               Message[]
  // Meta's conversation.id. Unique, so one WhatsApp conversation is stored once.
  whatsappConversationId String?   @unique @map("whatsapp_conversation_id")
  // Meta's pricing.category, e.g. "service" or "marketing".
  category               String?
  // Meta's conversation.origin.type, e.g. "service" or "marketing".
  originType             String?   @map("origin_type")
  // When the conversation began: the WhatsApp timestamp of the first message we stored in it.
  startedAt              DateTime  @map("started_at") @db.Timestamptz(3)
  // Meta's conversation.expiration_timestamp.
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Serves "latest conversation for a user" and the user_id foreign key.
  @@index([userId, createdAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                    String           @id @default(uuid(7)) @db.Uuid
  conversationId        String           @map("conversation_id") @db.Uuid
  conversation          Conversation     @relation(fields: [conversationId], references: [id])
  // Meta's ID for the message. Unique, so a redelivered webhook cannot store it
  // twice; optional, because an outbound reply only gets one after it is sent.
  whatsappMessageId     String?          @unique @map("whatsapp_message_id")
  direction             MessageDirection
  // Delivery status applies only to outbound messages. SENT means accepted by Meta.
  status                MessageStatus?
  dispatchCorrelationId String?          @map("dispatch_correlation_id")
  replyToMessageId      String?          @unique @map("reply_to_message_id") @db.Uuid
  replyToMessage        Message?         @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: Restrict)
  reply                 Message?         @relation("MessageReply")
  content               String
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  // Serves "messages in a conversation, oldest first" and the conversation_id foreign key.
  @@index([conversationId, createdAt])
  @@map("messages")
}
