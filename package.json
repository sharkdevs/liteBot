{
  "name": "litebot",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp AI assistant backend starter",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "dev:whatsapp": "tsx watch src/whatsapp.worker.ts",
    "start:whatsapp": "node dist/whatsapp.worker.js",
    "whatsapp:reconcile": "tsx src/reconcile-whatsapp.ts",
    "test": "node --import tsx --test tests/bootstrap.test.ts tests/webhook.test.ts tests/config.test.ts tests/prompt-builder.test.ts tests/ai-provider.test.ts tests/ai-response.service.test.ts tests/whatsapp-provider.test.ts tests/whatsapp-delivery.test.ts tests/delivery-reliability.test.ts",
    "test:integration": "node --import tsx --test tests/queue.integration.test.ts tests/persistence.integration.test.ts tests/delivery-recovery.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.7.6",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "openai": "7.57.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.1",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
