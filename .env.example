# Copy to .env and adjust. Never commit .env.

# --- Server ---
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- PostgreSQL (matches docker-compose.yml; required by the API and worker) ---
DATABASE_URL=postgresql://litebot:litebot@localhost:5432/litebot?schema=public

# --- Redis (matches docker-compose.yml; used by the API and worker since Phase 2) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Azure AI Foundry (required by the worker) ---
AI_PROVIDER=azure-foundry
# Use the Foundry OpenAI v1 endpoint, including /openai/v1/.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_MODEL=phi-4-mini

# --- WhatsApp webhook verification (required; choose your own token) ---
WHATSAPP_VERIFY_TOKEN=

# --- WhatsApp sending (used from a later stage) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
