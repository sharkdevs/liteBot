# Copy to .env and adjust. Never commit .env.

# --- Server ---
PORT=3000
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- PostgreSQL (matches docker-compose.yml; required by the API and both workers) ---
DATABASE_URL=postgresql://litebot:litebot@localhost:5432/litebot?schema=public

# --- Redis (matches docker-compose.yml; used by the API and both workers) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Azure AI Foundry (required only by the AI worker) ---
AI_PROVIDER=azure-foundry
# Use the Foundry OpenAI v1 endpoint, including /openai/v1/.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_MODEL=phi-4-mini

# --- WhatsApp webhook verification (required; choose your own token) ---
WHATSAPP_VERIFY_TOKEN=

# --- WhatsApp sending (required only by npm run dev:whatsapp) ---
# Starting this worker sends queued messages. Use isolated test recipients.
WHATSAPP_ACCESS_TOKEN=
# Numeric business phone number ID from Meta, not a recipient's phone number.
WHATSAPP_PHONE_NUMBER_ID=
